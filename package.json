{
  "name": "jason-tang-desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "content": "node scripts/legacy-routes.mjs",
    "build": "npm run content && vite build && node scripts/copy-static.mjs",
    "preview": "vite preview --host 127.0.0.1",
