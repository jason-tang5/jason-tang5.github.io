    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-video-ascii": "1.5.1",
    "vue": "^3.5.30"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "vite": "^7.0.0"
  }
}
