// cloudflare workers config for jasontang.dev.
// the built site in dist/ is served as static files. only /api/* and videos run
// the worker in worker/index.js, which sends the mail window's messages, saves
// blog posts, and answers the range requests safari needs to play video
{
	"name": "jasontang-dev",
	"main": "worker/index.js",
	"compatibility_date": "2026-09-25",
	"durable_objects": { "bindings": [{ "name": "LIVE_STATS", "class_name": "LiveStats" }] },
	"migrations": [{ "tag": "v1-live-stats", "new_sqlite_classes": ["LiveStats"] }],
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true,
			"persist": true
		}
	},
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*",
			"/*.mp4"
		]
	},
	// needs email routing turned on for jasontang.dev, with this address verified
	"send_email": [
		{
			"name": "SEND_EMAIL",
			"destination_address": "jasontcanada@gmail.com"
		}
	],
	// blog posts written from the site. create it with
	// `npx wrangler kv namespace create BLOG` and paste the id here
	"kv_namespaces": [
		{
			"binding": "BLOG",
			"id": "47a530bb2a704a848e32675d8694433d",
			"remote": true
		}
	],
	// only this email can write posts. ACCESS_TEAM_DOMAIN and ACCESS_AUD come from the
	// cloudflare access application protecting /api/admin/* (see the readme)
	"vars": {
		"ADMIN_EMAIL": "jasontcanada@gmail.com",
		"ACCESS_TEAM_DOMAIN": "quiet-butterfly-8b30.cloudflareaccess.com",
		"ACCESS_AUD": "f86b7c00ec8b87b8ee86249e4a3a9524dedc9ff6f7c36a5585d61de0d71c904c",
		// for reading analytics back (worker/analytics.mjs). the token is a secret:
		// `npx wrangler secret put ANALYTICS_TOKEN`, an api token with account analytics read
		"CLOUDFLARE_ACCOUNT_ID": "99cbd761f7464fae13039711f21bc25f"
	},
	// anonymous visit events for the analytics window, see worker/analytics.mjs
	"analytics_engine_datasets": [
		{
			"binding": "EVENTS",
			"dataset": "jasontang_events"
		}
	],
	"routes": [
		{
			"pattern": "jasontang.dev",
			"custom_domain": true
		}
	]
}