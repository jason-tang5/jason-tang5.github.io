// cloudflare workers config for jasontang.dev.
// the built site in dist/ is served as static files. only /api/* runs the
// worker in worker/index.js, which sends the mail window's messages
{
	"name": "jasontang-dev",
	"main": "worker/index.js",
	"compatibility_date": "2026-09-25",
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true,
			"persist": true
		}
	},
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		]
	},
	// needs email routing turned on for jasontang.dev, with this address verified
	"send_email": [
		{
			"name": "SEND_EMAIL",
			"destination_address": "jasontcanada@gmail.com"
		}
	],
	"routes": [
		{
			"pattern": "jasontang.dev",
			"custom_domain": true
		}
	]
}